# Turso database (prefer a READ-ONLY token for the dashboard:
#   turso db tokens create bike-tracker --read-only)
TURSO_DATABASE_URL=libsql://bike-tracker-<org>.turso.io
TURSO_AUTH_TOKEN=

# Login password for the dashboard
DASHBOARD_PASSWORD=

# Random string used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

PORT=8787

# CARTO basemap tiles (free key: https://carto.com/basemaps/apikey)
CARTO_API_KEY=
